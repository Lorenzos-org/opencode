#!/usr/bin/env sh

# Lightweight pre-commit checks for development
echo "Running pre-commit checks..."

# Only format check (no typecheck to speed up development)
echo "Running prettier check..."
bunx prettier --check .
if [ $? -ne 0 ]; then
  echo "Prettier check failed. Please format your code with 'bunx prettier --write .' before committing."
  exit 1
fi

echo "Pre-commit checks passed! Typecheck will run on push."