#!/usr/bin/env sh

# Streamlined pre-commit checks
echo "Running pre-commit checks..."

# Only check formatting on staged files (reduces false positives)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx|js|jsx|json|md)$')
if [ -n "$STAGED_FILES" ]; then
  echo "Checking formatting on staged files..."
  echo "$STAGED_FILES" | xargs bunx prettier --check
  if [ $? -ne 0 ]; then
    echo "Formatting issues found. Run 'bunx prettier --write .' to fix."
    exit 1
  fi
fi

# Quick lint check on staged files only
if [ -n "$STAGED_FILES" ]; then
  echo "Running lint on staged files..."
  echo "$STAGED_FILES" | xargs bunx eslint 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "Lint errors found. Please fix before committing."
    exit 1
  fi
fi

echo "Pre-commit checks passed! ✅"
