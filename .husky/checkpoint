#!/usr/bin/env sh

# Lightweight checkpoint hook for development sprints
# Only checks critical syntax and basic formatting

echo "Running development checkpoint..."

# Quick syntax check (no full typecheck)
echo "Checking syntax..."
bunx tsc --noEmit --skipLibCheck --strict false 2>/dev/null
if [ $? -ne 0 ]; then
  echo "Syntax errors found. Please fix before continuing."
  exit 1
fi

# Basic formatting check (only staged files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d | grep -E '\.(ts|tsx|js|jsx)$')
if [ -n "$STAGED_FILES" ]; then
  echo "Checking formatting on staged files..."
  echo "$STAGED_FILES" | xargs bunx prettier --check 2>/dev/null
  if [ $? -ne 0 ]; then
    echo "Formatting issues found. Run 'bunx prettier --write .' to fix."
    exit 1
  fi
fi

echo "Development checkpoint passed! ✅"